{
  "name": "nft-marketplace-graphql-server",
  "version": "2.0.0",
  "description": "Graphql API function for nft marketplace lambda.Digital",
  "scripts": {
    "dev": "sst dev",
    "deploy-dev": "sst deploy --stage dev",
    "deploy-prod": "sst deploy --stage production",
    "seed": "env TS_NODE_COMPILER_OPTIONS='{\"module\": \"commonjs\" }' ts-node scripts/seed.ts",
    "test:local": "bash scripts/test.sh",
    "test": "env TABLE_NAME=items-test DYNAMODB_ENDPOINT=http://localhost:8000 AWS_REGION=eu-central-1 AWS_ACCESS_KEY_ID=local AWS_SECRET_ACCESS_KEY=local TS_NODE_COMPILER_OPTIONS='{\"module\": \"commonjs\" }' mocha -r ts-node/register 'tests/**/*.ts'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@apollo/server": "^4.0.0",
    "@as-integrations/aws-lambda": "^3.0.0",
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "class-validator": "^0.14.3",
    "graphql": "^16.0.0",
    "reflect-metadata": "^0.1.13",
    "source-map-support": "^0.5.21",
    "type-graphql": "2.0.0-rc.4"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@types/chai": "^4.3.3",
    "@types/mocha": "^9.1.1",
    "chai": "^4.3.6",
    "mocha": "^10.0.0",
    "sst": "^3.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0"
  }
}
